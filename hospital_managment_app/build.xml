<project name="HospitalApp" default="package" basedir=".">
    <!-- ===================== 1. Ustawienia katalogów ===================== -->
    <property name="src.dir"        value="src/main/java"/>
    <property name="test.src.dir"   value="src/test/java"/>

    <property name="build.dir"      value="build/classes"/>
    <property name="test.build.dir" value="build/test-classes"/>

    <property name="reports.dir"    value="build/reports"/>
    <property name="html.dir"       value="build/reports/html"/>

    <property name="lib.dir"        value="lib"/>

    <!-- katalog artefaktów -->
    <property name="dist.dir"       value="dist"/>

    <!-- ===================== 2. ClassPath z bibliotekami ================= -->
    <path id="compile.classpath">
        <fileset dir="${lib.dir}">
            <include name="**/*.jar"/>
        </fileset>
    </path>

    <!-- ===================== 3. Kompilacja kodu produkcyjnego ============ -->
    <target name="compile">
        <echo>=== Kompilacja src/main/java ===</echo>
        <mkdir dir="${build.dir}"/>
        <javac srcdir="${src.dir}"
               destdir="${build.dir}"
               includeantruntime="false"
               classpathref="compile.classpath"/>
    </target>

    <!-- ===================== 4. Kompilacja testów ======================== -->
    <target name="compile-tests" depends="compile">
        <echo>=== Kompilacja src/test/java ===</echo>
        <mkdir dir="${test.build.dir}"/>
        <javac srcdir="${test.src.dir}"
               destdir="${test.build.dir}"
               includeantruntime="false">
            <classpath>
                <path refid="compile.classpath"/>
                <pathelement path="${build.dir}"/>
            </classpath>
        </javac>
    </target>

    <!-- ===================== 5. Testy JUnit + raporty ==================== -->
    <target name="test" depends="compile-tests">
        <echo>=== Uruchamianie testów ===</echo>
        <mkdir dir="${reports.dir}"/>
        <mkdir dir="${html.dir}"/>

        <junit printsummary="yes" haltonfailure="no" fork="yes">
            <classpath>
                <pathelement path="${build.dir}"/>
                <pathelement path="${test.build.dir}"/>
                <path refid="compile.classpath"/>
            </classpath>
            <formatter type="xml"/>
            <batchtest todir="${reports.dir}">
                <fileset dir="${test.build.dir}">
                    <include name="**/*Test.class"/>
                </fileset>
            </batchtest>
        </junit>

        <junitreport todir="${html.dir}">
            <fileset dir="${html.dir}">
                <include name="TEST-*.xml"/>
            </fileset>
            <!-- <report format="frames"/>  -->
        </junitreport>
    </target>

    <!-- ===================== 6. Budowanie FAT‑JAR‑a ===================== -->
    <target name="jar" depends="compile">
        <echo>=== Tworzenie FAT‑JAR‑a ===</echo>
        <mkdir dir="${dist.dir}"/>

        <jar destfile="${dist.dir}/${ant.project.name}.jar" basedir="${build.dir}">
            <!-- Dołącz wszystkie zależności z lib/ -->
            <zipgroupfileset dir="${lib.dir}" includes="**/*.jar"/>
            <manifest>
                <attribute name="Main-Class" value="hospital_managment_app.Hospital_managment_app"/>
            </manifest>
        </jar>
    </target>

    <!-- ===================== 7. Generowanie skryptów startowych ========= -->
    <target name="make-scripts" depends="jar">
        <echo>=== Generowanie skryptów run.sh / run.bat ===</echo>
        <!-- Unix/Linux/macOS script -->
        <echo file="${dist.dir}/run.sh"><![CDATA[
#!/usr/bin/env bash
DIR="$(cd "$(dirname "$0")" && pwd)"
java -jar "$DIR/HospitalApp.jar"
]]></echo>
        <chmod file="${dist.dir}/run.sh" perm="755"/>

        <!-- Windows script -->
        <echo file="${dist.dir}/run.bat"><![CDATA[
@echo off
java -jar "%~dp0HospitalApp.jar"
pause
]]></echo>
    </target>

    <!-- ===================== 8. Pakowanie ZIP‑a ========================= -->
    <target name="package" depends="make-scripts">
        <echo>=== Pakowanie ZIP ===</echo>
        <zip destfile="${dist.dir}/${ant.project.name}.zip">
            <fileset dir="${dist.dir}">
                <include name="HospitalApp.jar"/>
                <include name="run.sh"/>
                <include name="run.bat"/>
            </fileset>
        </zip>
    </target>

    <!-- ===================== 9. Test lokalny ============================ -->
    <target name="run" depends="jar">
        <echo>=== Uruchamianie aplikacji (fat‑jar) ===</echo>
        <java jar="${dist.dir}/${ant.project.name}.jar" fork="true"/>
    </target>

    <!-- ===================== 10. Sprzątanie ============================ -->
    <target name="clean">
        <echo>=== Czyszczenie build/ + dist/ + reports/ ===</echo>
        <delete dir="${build.dir}"/>
        <delete dir="${test.build.dir}"/>
        <delete dir="${reports.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>
</project>
